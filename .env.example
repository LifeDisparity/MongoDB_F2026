# Server-side configuration. Never commit populated credentials.
MONGODB_URI=
MONGODB_DATABASE=living_atlas
OPENAI_API_KEY=
MODEL_ID=
RUN_TOKEN_BUDGET=150000
RUN_MAX_TOOL_CALLS=24
MAX_CONCURRENT_INVESTIGATIONS=2
ENABLE_DEMO_SOURCE_WITHDRAWAL=false

# Current source workspace (server-only; private text remains ignored).
LIVING_ATLAS_SOURCE_MANIFEST=data/manifests/showcase.json
SOURCE_CACHE_DIR=data/raw/flyaoc
# Local development: .venv/bin/python scripts/dev.py --local-mongo --allow-demo
# MODEL_ID / model budgets above are reserved for the later scientific workflow.
